# =====================================================================
#  En-têtes de sécurité Netlify — projetpati.com / L'Atelier Solidaire
#  Placé dans public/ => copié tel quel à la racine du build par Vite.
#  Après déploiement, vérifier sur https://securityheaders.com
#  ⚠ Tester le site : si une page reste blanche, c'est la CSP — voir la
#    note en bas (ajuster la directive concernée, pas tout ouvrir).
# =====================================================================

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://i.ytimg.com; media-src 'self' https: blob:; connect-src 'self' https://*.supabase.co https://plausible.io; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests

# Le mini-jeu HTML utilise des <script> en ligne : CSP dédiée (1re partie, même origine)
/jeux/*
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co https://plausible.io

# Cache long pour les assets fingerprintés (perf, pas sécurité)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ---------------------------------------------------------------------
# NOTES D'AJUSTEMENT (si quelque chose casse après mise en ligne) :
#  • Page blanche au chargement => regarder la console : un message
#    "Refused to load/execute ... violates Content-Security-Policy".
#  • Si la balise <script> de Plausible est servie depuis un autre
#    domaine que plausible.io, ajoute-le dans script-src ET connect-src.
#  • Si tu ajoutes un fournisseur (Turnstile, Stripe, Calendly…), pense à
#    l'ajouter à script-src / frame-src / connect-src selon le cas.
#    Cloudflare Turnstile = script-src https://challenges.cloudflare.com
#                           frame-src  https://challenges.cloudflare.com
#  • NE PAS ajouter 'unsafe-inline' à script-src de /* : ce serait rouvrir
#    la principale porte au XSS. Préférer un hash/nonce si besoin.
# ---------------------------------------------------------------------
